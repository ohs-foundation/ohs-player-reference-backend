# Copy to .env and fill in the required values:  cp .env.example .env
#
# Use host.docker.internal to reach services running on the Docker host,
# e.g. PROXY_TO=http://host.docker.internal:8099/fhir

# ---- Required (startup fails with an explicit error if any is missing) ----
# Upstream FHIR server base URL.
# Joined to the nawi-devops stack:  http://fhir:8080/fhir
# Via the host instead:             http://host.docker.internal:8082/fhir
PROXY_TO=
# Keycloak issuer URL. The server URL and realm are parsed from this value.
#
# IMPORTANT: this must EXACTLY equal the `iss` claim of the tokens you send.
# JwtTokenValidator requires an exact issuer match, and Keycloak in start-dev mode
# derives `iss` from the request host, so a token fetched from http://localhost:8081
# carries iss=http://localhost:8081/realms/ohs-player and will be REJECTED when
# TOKEN_ISSUER is http://keycloak:8080/realms/ohs-player. See "Keycloak issuer
# alignment" in README.md.
TOKEN_ISSUER=
# Keycloak admin client with service accounts enabled. See "Keycloak Setup" in README.md.
IAM_PROVIDER_CLIENT_ID=
IAM_PROVIDER_CLIENT_SECRET=

# ---- FHIR Gateway ----
# HAPI or GCP
BACKEND_TYPE=HAPI
# Governs /fhir/* proxy access only. `permissive` is honored only when RUN_MODE=DEV.
ACCESS_CHECKER=list
# PROD enforces the token issuer check; DEV bypasses it.
RUN_MODE=PROD
# Path to an allowed-queries JSON file. The image ships
# /app/resources/hapi_page_url_allowed_queries.json.
ALLOWED_QUERIES_FILE=
# Subset of C R U D E enabling AuditEvent logging; empty disables it.
AUDIT_EVENT_ACTIONS_CONFIG=
# Defaults to .well-known/openid-configuration when empty.
WELL_KNOWN_ENDPOINT=
# Port the gateway listens on inside the container.
PROXY_PORT=8080

# ---- Compose ----
# Host port mapped to the container's PROXY_PORT.
HOST_PORT=8080
# Image tag used by docker compose.
IMAGE_TAG=local
# Git repository to build the gateway jar from. Override to build from a fork. Must be an HTTPS
# URL: the build stage has no SSH keys, so git@github.com:... cannot be cloned.
GATEWAY_REPO=https://github.com/ohs-foundation/fhir-gateway.git
# Branch, tag or full 40-character commit SHA of GATEWAY_REPO to build the gateway jar from.
# Abbreviated SHAs do not resolve over the wire. A branch name is a fixed cache key, so the build
# will reuse a stale checkout when the branch moves; pin a SHA or a new tag to force a re-fetch.
GATEWAY_REF=main

# ---- OHS Player extensions ----
IAM_PROVIDER=keycloak
# Rows per batch for the organization, location and user-assignment bulk imports.
BULK_IMPORT_BATCH_SIZE=50
# Maximum time in milliseconds to establish a connection to the upstream FHIR server.
FHIR_CLIENT_CONNECT_TIMEOUT_MS=5000
# Maximum time in milliseconds to wait for one upstream FHIR response.
FHIR_CLIENT_READ_TIMEOUT_MS=30000
# Parent Location ids per upstream Location.partOf search request.
LOCATION_HIERARCHY_MAX_PART_OF_BATCH_SIZE=100
# Child Locations requested per upstream FHIR search page.
LOCATION_HIERARCHY_UPSTREAM_PAGE_SIZE=200
# Deepest child level returned below the requested root; 0 returns only the root.
LOCATION_HIERARCHY_MAX_DEPTH=25
# Maximum Location nodes in one hierarchy response, including the root.
LOCATION_HIERARCHY_MAX_NODES=10000
# How long a built hierarchy stays in this JVM's cache.
LOCATION_HIERARCHY_CACHE_TTL_SECONDS=86400
# Approximate maximum cached Location nodes across all hierarchy responses in this JVM.
LOCATION_HIERARCHY_CACHE_MAX_TOTAL_NODES=100000
# TRACE, DEBUG, INFO, WARN or ERROR
LOGGING_LEVEL_DEV_OHS_PLAYER=INFO

# ---- JVM ----
JAVA_OPTS=-XX:MaxRAMPercentage=75
# Remote debugging, equivalent to test-runner.sh. Also uncomment the 5005 port mapping
# in docker-compose.yml.
# JAVA_OPTS=-XX:MaxRAMPercentage=75 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
